/* توسعه توسط قلموم */
add_action('admin_footer', 'ghalamom_insert_text_in_wpfooter');
function ghalamom_insert_text_in_wpfooter() {
    ?>
    <style>
        .ghalamom-footer-message {
            font-family: Vazir, sans-serif;
            font-size: 13px;
            color: #555;
            text-decoration: none;
            display: inline-block;
			margin-top: -18px;
            text-align: right;
            float: right;
            transition: color 0.3s ease;
        }

        .ghalamom-footer-message:hover {
            color: #383751;
			font-weight:500;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var wpfooter = document.getElementById('wpfooter');
            if (!wpfooter) return;

            var div = document.createElement('div');
            div.innerHTML = '<a href="https://ghalamom.ir/" target="_blank" class="ghalamom-footer-message">توسعه توسط قلموم</a>';

            wpfooter.appendChild(div);
        });
    </script>
    <?php
}

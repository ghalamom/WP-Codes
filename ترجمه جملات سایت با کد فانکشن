add_filter('gettext', 'custom_bulk_translate_texts', 999, 3);
add_filter('ngettext', 'custom_bulk_translate_texts', 999, 3);

function custom_bulk_translate_texts($translated, $text, $domain) {

    // لیست ترجمه‌های سفارشی
    $custom_translations = array(
        'Apply'             => 'اعمال کردن',
        'No products in the cart.'             => 'محصولی در سبدخرید نیست',
		'Coupon code'             => 'کد تخفیف',
		'If you have a coupon code, please apply it below.'             => 'اگر کد تخفیف دارید، آن را در فرم زیر وارد کنید',
		' customer review'             => ':تعداد نظرات',
    );

    // بررسی و جایگزینی
    if ( isset($custom_translations[$text]) ) {
        $translated = $custom_translations[$text];
    }

    return $translated;
}









add_filter( 'gettext', 'translate_woocommerce_strings', 20, 3 );
function translate_woocommerce_strings( $translated_text, $text, $domain ) {
    $translations = array(
        'Please enter a coupon code.'      => 'لطفا کد تخفیف را وارد کنید',
	    'cannot be applied because it does not exist'      => 'قابل اجرا نیست چون وجود نداره',
		' cannot be applied because it does not exist.'      => 'قابل اجرا نیست چون وجود نداره',
	    'cannot be applied because it does not exist.'      => 'قابل اجرا نیست چون وجود نداره',
	    'Coupon'      => 'کد تخفیف',
	    'Coupon '      => 'کد تخفیف',
	    'Price'      => 'قیمت',
		'Subtotal'      => 'قیمت کل',
		'View cart'      => 'مشاهده سبد خرید',
		'No products in the cart.'      => 'محصولی به سبد خرید اضافه نشده.',

    );

    if ( array_key_exists( $text, $translations ) ) {
        return $translations[$text];
    }

    return $translated_text;
}












